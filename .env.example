# PORT: HTTP and WebSocket server port (defaults to 3000)
PORT="3000"

# ADMIN_EMAIL: Verified email address granted movie upload, edit, and delete privileges
ADMIN_EMAIL="madubachigozie00@gmail.com"

# APP_URL: The public URL where this app is hosted
APP_URL="https://templesolosmovies.com"

# VITE_GAME_SERVER_URL: Optional WebSocket/Socket.IO backend origin when frontend & server are hosted separately
VITE_GAME_SERVER_URL=""

# GEMINI_API_KEY: Server-side Gemini API key (automatically injected in AI Studio)
GEMINI_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform browser key
VITE_GOOGLE_MAPS_API_KEY=""

# Cloudinary Storage (for unsigned uploads, only VITE_CLOUDINARY_CLOUD_NAME and VITE_CLOUDINARY_UPLOAD_PRESET are needed)
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# Spotify Web Playback SDK OAuth (optional; enables full-track playback for Spotify Premium users)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
